{
  "//": "Repo-only: lets the example spells typecheck against ../runtime. A user's grimoire gets a generated tsconfig and node_modules links instead.",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "typeRoots": ["../runtime/node_modules/@types"],
    "paths": {
      "cantrip": ["../runtime/src/sdk/index.ts"],
      "effect/*": ["../runtime/node_modules/effect/dist/*.d.ts"]
    }
  }
}
